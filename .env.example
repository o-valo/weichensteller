[TEMPLATE]
# ============================================================================
#  Ollama-Bahnhof - Konfiguration (.env)
# ============================================================================
#  Format wie beim llm-bahnhof: KEY=WERT, "#" und ";" leiten Kommentare ein,
#  eine Kopfzeile wie [TEMPLATE] wird uebergangen.
#  Gueltigkeit: diese Datei  >  Umgebungsvariable gleichen Namens  >  Vorgabe.
#  Anderer Ort: WEICHENSTELLER_ENV bzw. DOTENV_PATH setzen oder --env PFAD benutzen.
#
#  Diese Vorlage nach ".env" kopieren und anpassen:
#      cp .env.example .env
# ============================================================================

# -------------------------------------------------- Pseudo-Modell (Einstieg) ----
# Der Name, den ein Client anspricht - genau wie VIRTUAL_MODEL beim
# llm-bahnhof. Er steht immer in /api/tags, /api/show, /api/ps und /v1/models.
#
#   * Ist ein Gleis (ROUTE_xx) konfiguriert, geht die Anfrage mit dem
#     Ziel-Modell des Gleises nach vorne -> echte Antwort vom Anbieter.
#   * Ohne Gleis - oder wenn alle Gleise ausfallen und SIM_FALLBACK=1 gilt -
#     antwortet die Simulation.
#
# Ohne Tag wird ":latest" ergaenzt (wie bei Ollama), "ollama-bahnhof" und
# "weichensteller:latest" sind also derselbe Einstieg.
VIRTUAL_MODEL=weichensteller:latest

# Faehigkeiten des Pseudo-Modells (Komma): completion, tools, thinking,
# vision, embedding. Steht "embedding" nicht dabei, weist /api/embed das
# Modell ab - so wie ein echtes Chat-Modell es taete.
VIRTUAL_MODEL_FAEHIGKEITEN=completion,tools,thinking

# Familie fuer /api/show (Schluessel der model_info-Ausgabe und Anzeige)
VIRTUAL_MODEL_FAMILIE=weichensteller

# ---------------------------------------------------------------- Betrieb ----
# auto          = Gleis benutzen, wenn eines da ist - sonst simulieren
# simulation    = nie ein Gleis anfassen, immer simulieren
# durchreichen  = nur echte Gleise; ohne Gleis eine Fehlermeldung
MODUS=auto

# 1 = wenn alle Gleise ausfallen, im Notbetrieb simulieren (mit Hinweis im Text)
SIM_FALLBACK=0

# Adresse. WEICHENSTELLER_PORT=11434 ist der Ollama-Port - der Weichensteller ist damit
# ohne Umstellung anstelle eines echten Ollama einsetzbar. Laeuft auf der
# Maschine schon ein echtes Ollama, einen anderen Port nehmen (z. B. 11435).
WEICHENSTELLER_HOST=0.0.0.0
WEICHENSTELLER_PORT=11434

# CORS-Kopfzeilen (fuer Browser-Werkzeuge wie Open WebUI im Browser) - 1/0
WEICHENSTELLER_CORS=1

# Ordner fuer Zustand (gezogene Modelle, Blobs) und Protokolldatei
# WEICHENSTELLER_STATE=/home/bot/ollama-bahnhof/state
# WEICHENSTELLER_LOG=/home/bot/ollama-bahnhof/weichensteller.log

# ------------------------------------------------------------- Simulation ----
# Version, die /api/version meldet (aktuell ist Ollama 0.34.x)
SIM_VERSION=0.34.2

# 1 = simulierte Antworten sind im Text als Simulation gekennzeichnet.
# Ehrlichkeit vor Bequemlichkeit: wer den Text liest, sieht, dass kein Modell
# geantwortet hat. Fuer Vorfuehrungen abschaltbar.
SIM_MARKER=1

# Pause zwischen zwei Streaming-Haeppchen in Millisekunden (0 = kein Warten).
# Damit fuehlt sich der Strom wie ein echtes Modell an.
SIM_DELAY_MS=20

# Dimension der simulierten Einbettungen
SIM_EMBED_DIM=768

# Werkzeugaufrufe in der Simulation:
#   auto = nur wenn die Anfrage danach klingt ("nutze das Werkzeug ...")
#   aus  = nie
#   <name> = immer genau dieses Werkzeug aufrufen
SIM_TOOLCALL=auto

# Was passiert bei einem Modellnamen, der nicht im Katalog steht?
#   annehmen = erfinden (bequem)   ablehnen = 404 wie echtes Ollama
SIM_UNBEKANNT=annehmen

# Angenommene Geschwindigkeit fuer die Zaehlwerte/Restlaufzeiten (tok/s)
SIM_TOKENS_PRO_S=25

# keep_alive-Vorgabe, wenn der Client keine schickt
SIM_KEEP_ALIVE=5m

# ----------------------------------------------------------------- Gleise ----
# Format (wie beim llm-bahnhof, damit Konfigurationen austauschbar sind):
#     ROUTE_NN = URL | Schluessel | Ziel-Modell | Timeout
#
#   URL         Basis-URL eines OpenAI-kompatiblen Endpunkts; "/chat/completions"
#               wird bei Bedarf ergaenzt. Auch eine volle URL ist erlaubt.
#   Schluessel  API-Schluessel, "none" oder leer = der Schluessel des Clients
#               wird durchgereicht (praktisch fuer Ollama Cloud & Co.)
#   Ziel-Modell Modell beim Anbieter; leer = Modellname des Clients
#   Timeout     30, 90s, 15m, 2h oder 0 (= kein Timeout)
#
# Reihenfolge = Fallback-Reihenfolge (ROUTE_01 zuerst).
# Beispiel: llm-bahnhof im eigenen Netz als vorgelagertes Gleis
# ROUTE_01=http://10.7.0.124:8000/v1|none|glm-4.7-flash|15m
# Beispiel: Ollama Cloud (Schluessel kommt vom Client)
# ROUTE_02=https://ollama.com/v1|none|deepseek-v4|15m
# Beispiel: echtes Ollama im Netz
# ROUTE_03=http://10.7.0.79:11434|none|granite4.1:8b|10m

# ---------------------------------------------------------------- Katalog ----
# Was /api/tags und /api/ps anzeigen. Format:
#     MODEL_NN = Name | Parameter | Quantisierung | Familie | Faehigkeiten | Groesse_GB
# Faehigkeiten: completion, tools, thinking, vision, embedding (Komma-getrennt)
# Ohne MODEL_xx gilt der eingebaute Beispielkatalog.
MODEL_01=gemma4:8b|8.0B|Q4_K_M|gemma4|completion,tools,thinking|5.2
MODEL_02=qwen3.6:8b|8.2B|Q4_K_M|qwen3|completion,tools,thinking|5.4
MODEL_03=granite4.1:8b|8.2B|Q4_K_M|granite|completion,tools|5.1
MODEL_04=embeddinggemma:300m|0.3B|F16|embeddinggemma|embedding|0.6

# ============================================================================
#  Verbindung zum LLM-Bahnhof (das Neue gegenueber dem Ollama-Bahnhof)
# ============================================================================
#  Nach aussen ist dieser Weichensteller ein vollstaendiger Ollama-Server. Innen holt
#  er sich die Gleise aus ZWEI Quellen, in fester Reihenfolge:
#    1. die Routenliste des LLM-Bahnhofs (LLM_BAHNHOF_ENV)
#    2. die eigenen ROUTE_xx dieser Datei
#
#  Die beiden werden zu EINER Kette verbunden - die Reihenfolge entscheidet,
#  welches Gleis zuerst probiert wird.
#
#  Konfigurationsdatei des LLM-Bahnhofs. "~" wird aufgeloest. Fehlt die Datei,
#  gelten nur die eigenen Gleise (kein Fehler, nur ein Hinweis im Protokoll).
LLM_BAHNHOF_ENV=~/llm-bahnhof/.env

#  Feste Reihenfolge der Quellen:
#    llm-zuerst     erst LLM-Bahnhof, dann eigene   (Vorgabe)
#    eigene-zuerst  erst eigene, dann LLM-Bahnhof
#    nur-llm        nur die Gleise des LLM-Bahnhofs
#    nur-eigene     nur die eigenen Gleise
GLEIS_REIHENFOLGE=llm-zuerst

#  1 = erfolgreiches Gleis merken (Sticky-Fallback wie im LLM-Bahnhof): die
#      naechste Anfrage beginnt dort und laeuft im Kreis weiter. Das verhindert,
#      dass jede Anfrage wieder auf ein eben ausgefallenes Gleis springt.
#  0 = jede Anfrage beginnt wieder beim ersten Gleis (wie im Ollama-Bahnhof).
STICKY_FALLBACK=1

#  Hinweis: aus ROUTE_01 der fremden Datei wird llm-ROUTE_01 - die eigenen
#  Namen bleiben unveraendert, damit sich beide Quellen nie ueberschreiben.
# ============================================================================
